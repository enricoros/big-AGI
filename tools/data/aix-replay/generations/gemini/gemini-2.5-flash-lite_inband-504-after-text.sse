data: {"candidates": [{"content": {"parts": [{"text": " the occasional repair of his fishing gear. He was a man of routine, his days dictated by the rhythm of the sun, the tides, and the ever-present need to keep the light burning.\n\nTonight, however, there was a subtle unease in"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 27,"candidatesTokenCount": 508,"totalTokenCount": 535,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 27}],"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash-lite","responseId": "11fyavzaKs-sz7IPi73BkQs"}

