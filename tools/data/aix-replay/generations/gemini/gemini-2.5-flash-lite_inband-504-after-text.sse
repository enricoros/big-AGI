data: {"candidates": [{"content": {"parts": [{"text": "pers\n\n**Chapter 1: The Setting Sun and the Empty Shore**\n\nThe sun, a bruised and bleeding orange, dipped below the horizon, casting long, skeletal shadows across the craggy expanse of the Isle of Whispers. Silas"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 27,"candidatesTokenCount": 65,"totalTokenCount": 92,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 27}],"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash-lite","responseId": "11fyavzaKs-sz7IPi73BkQs"}

data: {"candidates": [{"content": {"parts": [{"text": ", his weathered face etched with lines as intricate as the sea charts in his small office, stood at the railing of the lighthouse gallery, his gaze sweeping across the restless grey water. The wind, a constant companion, tugged at his thick"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 27,"candidatesTokenCount": 113,"totalTokenCount": 140,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 27}],"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash-lite","responseId": "11fyavzaKs-sz7IPi73BkQs"}

data: {"candidates": [{"content": {"parts": [{"text": " wool sweater, carrying the briny tang of salt and the faint, melancholic cry of gulls.\n\nHe’d been the keeper of the Whispering Light for seventeen years. Seventeen years of tending the colossal Fresnel lens, polishing its prisms"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 27,"candidatesTokenCount": 162,"totalTokenCount": 189,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 27}],"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash-lite","responseId": "11fyavzaKs-sz7IPi73BkQs"}

data: {"candidates": [{"content": {"parts": [{"text": " until they gleamed with an internal fire, and ensuring its steadfast beam cut through the darkness, a promise of safety to ships navigating these treacherous waters. He’d arrived a young man, eager to escape the clamor of the mainland and the whispers of his"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 27,"candidatesTokenCount": 214,"totalTokenCount": 241,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 27}],"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash-lite","responseId": "11fyavzaKs-sz7IPi73BkQs"}

data: {"candidates": [{"content": {"parts": [{"text": " own past. He’d found solace, and a profound, almost monastic purpose, on this isolated rock.\n\nThe island itself was a character in his life. It was a jagged shard of granite thrust from the sea, its cliffs battered"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 27,"candidatesTokenCount": 262,"totalTokenCount": 289,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 27}],"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash-lite","responseId": "11fyavzaKs-sz7IPi73BkQs"}

data: {"candidates": [{"content": {"parts": [{"text": " by centuries of relentless waves. Sparse, tenacious vegetation clung to the soil, a hardy blend of sea thrift, heather, and salt-resistant grasses that shivered in the wind. There were no trees, no sheltered coves, only the raw"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 27,"candidatesTokenCount": 311,"totalTokenCount": 338,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 27}],"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash-lite","responseId": "11fyavzaKs-sz7IPi73BkQs"}

