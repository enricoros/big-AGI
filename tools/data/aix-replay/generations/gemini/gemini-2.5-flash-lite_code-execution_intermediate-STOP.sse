data: {"candidates": [{"content": {"parts": [{"executableCode": {"language": "PYTHON","code": "def is_prime(n):\n    if n \u003c 2:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\n\nprime_sum = 0\ncount = 0\nnum = 2\nwhile count \u003c 50:\n    if is_prime(num):\n        prime_sum += num\n        count += 1\n    num += 1\n\nprint(f\"The sum of the first 50 prime numbers is: {prime_sum}\")"}}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 58,"candidatesTokenCount": 133,"totalTokenCount": 191,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 58}],"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash-lite","responseId": "9FbyasixBeb6qtsPwdzp4Qc"}

