data: {"type":"content_block_start","index":4,"content_block":{"type":"web_search_tool_result","tool_use_id":"call_01_ET_5z1FmPWjhq8nhIwQIZsp6057","content":[{"type":"web_search_result","title":"Paris news - Today’s latest updates - Paris","url":"https://www.cbsnews.com/detroit/tag/paris/#1","encrypted_content":"","page_age":null,"snippet":"France's Macron pushes for fast-track ban on social media for kids under 15 ... See the jewels the Louvre thieves stole — and one they didn't get away with ... Louvre robbery leaves Paris' iconic museum shuttered for a second day","site_name":"CBS News","site_icon":"https://cdn.deepseek.com/site-icons/cbsnews.com"},{"type":"web_search_result","title":"Paris news - Today’s latest updates - Paris","url":"http://www.cbsnews.com/tag/paris/2/#app#1","encrypted_content":"","page_age":null,"snippet":"Paris ## U.S.-bound flight diverted over passenger from Congo amid Ebola restrictions ... Chanel sends controversial sandal down runway ... 2 more arrests in attempted bombing at Bank of America building in Paris ... 15 ... Louvre partially reopens, workers extend strike ... amid case appeal","site_name":"CBS News","site_icon":"https://cdn.deepseek.com/site-icons/cbsnews.com"},{"type":"web_search_result","title":"Paris news - Today’s latest updates - Paris","url":"https://www.cbsnews.com/tag/paris/#1","encrypted_content":"","page_age":null,"snippet":"Riot police clash with students in Paris ... Thousands protest school conditions in France ... Pope Leo criticizes France's euthanasia law ... France investigates removal of female Eiffel Tower staff for Hindu group's visit ... Former model scout linked to Jeffrey Epstein found dead in his Paris home ... Wildfires are roaring near Paris","site_name":"CBS News","site_icon":"https://cdn.deepseek.com/site-icons/cbsnews.com"},{"type":"web_search_result","title":"Paris","url":"https://abc7news.com/tag/Paris/","encrypted_content":"","page_age":null,"snippet":"Unexploded WWII bomb in Paris halts Eurostar trains ... American in custody after newborn thrown from Paris hotel window ... Lady Gaga introduces Michael Polansky as her fiancé in Paris ... French rail lines disrupted ahead of Paris Olympics Opening Ceremony ... Paris mayor dips into the Seine River to prove its clean for Olympics","site_name":"ABC7 San Francisco","site_icon":"https://cdn.deepseek.com/site-icons/abc7news.com"},{"type":"web_search_result","title":"L’actualité en direct et info du jour en continu - 20 Minutes - Le Direct","url":"https://www.20minutes.fr/actus?srch_tag=sdzwqwfqm3vqmslukqf2ucmepisdvfpb#page-wrap#1","encrypted_content":"lFIHuqFqmWBzsH+DNs86Q2GUl1VeK10DnSGos+MMgROzNyPW3m9X9mgah0v8yRkYmWVA7wFdpHqJ1K6rv81zWNHFCzlNT3Pg+55PFXTK3t4ptcT9RyWlgCiuTmeXiiMqhstNj1/ipWTiyHa3ZtGTrLhvn//MMEPnWbkcC7NVVdHLjXI+502i7N9isbPqJUz/FmUC//2KAFUVuqjM0mq92RbfdyDIaRGJQ/z+jR1vAcr7YuTIQmlb2mila9mVXWrUdndJDTndYysg5zBDb/84","page_age":null,"snippet":"Macron plaide pour « préserver l’union » au sommet de la Francophonie ... Une centaine de gardes à vue à la manif de samedi à Paris, 38 mineurs Le parquet de Paris évoque « principalement » des « groupements en vue de commettre des violences »","site_name":"20 Minutes","site_icon":"https://cdn.deepseek.com/site-icons/20minutes.fr"},{"type":"web_search_result","title":"paris - Brave Search - The Guardian • 4天前","url":"https://safe.search.brave.com/news?q=paris&source=web#1","encrypted_content":"","page_age":null,"snippet":"Indian man sentenced in Paris over a global Discord ring accused of abusing children ... France protests latest: Tear gas fired in Paris; half of French schools closed; thousands of students storm streets | World News | Sky News ... France student protests spread from Paris, with violent clashes forcing hundreds of high schools to close - CBS News","site_name":"Brave","site_icon":"https://cdn.deepseek.com/site-icons/brave.com"},{"type":"web_search_result","title":"paris news","url":"https://cn.bing.com/news/search?q=paris+news&qft=interval%3d%22