{
 "model": "gpt-6-astra",
 "stream": true,
 "store": false,
 "reasoning": {
  "effort": "low",
  "summary": "auto"
 },
 "tools": [
  {
   "type": "web_search",
   "search_context_size": "low",
   "user_location": {
    "type": "approximate"
   },
   "external_web_access": true
  }
 ],
 "input": [
  {
   "role": "user",
   "content": [
    {
     "type": "input_text",
     "text": "Search the web for three unrelated facts: (a) the weather forecast for Lisbon tomorrow, (b) the current EUR to USD exchange rate, (c) the current LTS version of Node.js. One short line per fact."
    }
   ]
  }
 ],
 "max_output_tokens": 6000,
 "include": [
  "web_search_call.action.sources",
  "code_interpreter_call.outputs",
  "reasoning.encrypted_content"
 ]
}